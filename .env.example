# Database Configuration
# Options: sqlite, postgres
DATABASE_TYPE=sqlite

# SQLite configuration (used when DATABASE_TYPE=sqlite)
SQLITE_PATH=./shortener.db

# PostgreSQL configuration (used when DATABASE_TYPE=postgres)
POSTGRES_HOST=shortener-postgres
POSTGRES_PORT=5432
POSTGRES_USER=shortener
POSTGRES_PASSWORD=shortener
POSTGRES_DB=shortener

# Celery Configuration
CELERY_BROKER_URL=redis://shortener-redis:6379/0
CELERY_RESULT_BACKEND=redis://shortener-redis:6379/0

# Code Pool Configuration
CODE_POOL_TARGET_AVAILABLE=1000
RESERVED_CODE_TIMEOUT_SECONDS=300
